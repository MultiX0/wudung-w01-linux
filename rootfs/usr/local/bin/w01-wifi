#!/bin/sh
#
# w01-wifi - connect the Wudung W01 built-in WiFi, and keep it connected.
#
#   w01-wifi                 show status and IP
#   w01-wifi scan            list nearby networks
#   w01-wifi connect         interactive: pick SSID, enter password, save
#   w01-wifi static <ip>     pin a static address, e.g. w01-wifi static 192.0.2.50
#   w01-wifi dhcp            go back to DHCP
#   w01-wifi forget          remove the saved network
#
# The saved network is reconnected automatically on every boot and whenever
# the link drops - that is handled by wpa_supplicant@<iface> and dhcpcd@<iface>,
# which this script enables for you.
set -u

iface() {
    for d in /sys/class/net/*/wireless; do
        [ -e "$d" ] && basename "$(dirname "$d")" && return 0
    done
    return 1
}

W=$(iface || true)
if [ -z "${W:-}" ]; then
    echo "No wireless interface found."
    echo
    echo "  driver loaded? :  lsmod | grep atbm"
    echo "  driver errors? :  dmesg | grep -i atbm | tail"
    echo "  firmware here? :  ls -l /lib/firmware/atbm_fw.bin"
    exit 1
fi

CONF="/etc/wpa_supplicant/wpa_supplicant-$W.conf"

show_status() {
    echo "interface : $W"
    if iw dev "$W" link 2>/dev/null | grep -q "Connected to"; then
        iw dev "$W" link | sed -n 's/^[[:space:]]*/  /p' | head -8
    else
        echo "  not connected"
    fi
    IP=$(ip -4 addr show "$W" 2>/dev/null | sed -n 's/.*inet \([0-9.]*\).*/\1/p' | head -1)
    echo
    if [ -n "$IP" ]; then
        echo "  IP address: $IP"
        echo "  ssh root@$IP"
    else
        echo "  no IP address"
    fi
}

case "${1:-status}" in
status)
    show_status
    ;;

scan)
    ip link set "$W" up 2>/dev/null
    sleep 2
    iw dev "$W" scan 2>/dev/null | sed -n 's/^[[:space:]]*SSID: //p' | sort -u | grep -v '^$'
    ;;

connect)
    ip link set "$W" up 2>/dev/null
    sleep 2
    echo "Nearby networks:"
    iw dev "$W" scan 2>/dev/null | sed -n 's/^[[:space:]]*SSID: //p' | sort -u | grep -v '^$' | sed 's/^/  /'
    echo
    printf "SSID: "
    read -r SSID
    [ -n "$SSID" ] || { echo "no SSID given"; exit 1; }
    printf "Password (leave empty for an open network): "
    # restore echo even if the user hits Ctrl-C at the prompt
    trap 'stty echo 2>/dev/null; echo; exit 130' INT TERM
    trap 'stty echo 2>/dev/null' EXIT
    stty -echo 2>/dev/null
    read -r PASS
    stty echo 2>/dev/null
    trap - INT TERM EXIT
    echo

    mkdir -p /etc/wpa_supplicant
    # Build into a temp file first. Writing straight to $CONF truncates it
    # before wpa_passphrase runs, so a rejected passphrase would destroy a
    # working saved network and lock you out of a headless box.
    TMPC=$(mktemp) || exit 1
    if [ -z "$PASS" ]; then
        {
            echo "network={"
            echo "  ssid=\"$SSID\""
            echo "  key_mgmt=NONE"
            echo "}"
        } > "$TMPC"
    elif ! wpa_passphrase "$SSID" "$PASS" > "$TMPC"; then
        rm -f "$TMPC"
        echo "wpa_passphrase rejected that (WPA passwords are 8 to 63 characters)."
        echo "Your previous network, if any, has been left alone."
        exit 1
    fi
    unset PASS
    mv "$TMPC" "$CONF"
    chmod 600 "$CONF"

    # These two are what make the box reconnect after a reboot. If either
    # fails, say so: the alternative is finding out after a power cycle with
    # no network to debug over.
    systemctl enable "wpa_supplicant@$W" >/dev/null \
        || echo "WARNING: could not enable wpa_supplicant@$W, WiFi will not come up at boot"
    systemctl enable "dhcpcd@$W" >/dev/null \
        || echo "WARNING: could not enable dhcpcd@$W, no address at boot"
    systemctl restart "wpa_supplicant@$W"
    echo "associating..."
    i=0
    while [ $i -lt 20 ]; do
        iw dev "$W" link 2>/dev/null | grep -q "Connected to" && break
        sleep 1; i=$((i+1))
    done
    systemctl restart "dhcpcd@$W"
    echo "requesting address..."
    i=0
    while [ $i -lt 20 ]; do
        ip -4 addr show "$W" | grep -q "inet " && break
        sleep 1; i=$((i+1))
    done
    echo
    show_status
    ;;

static)
    ADDR="${2:-}"
    [ -n "$ADDR" ] || { echo "usage: w01-wifi static <ip>[/prefix]"; exit 1; }
    case "$ADDR" in */*) ;; *) ADDR="$ADDR/24" ;; esac
    # Anything is accepted by dhcpcd.conf without complaint, and the restart
    # below then takes the interface down. On a headless box that is a one
    # way trip, so refuse anything that is not an IPv4 address.
    case "$ADDR" in
        [0-9]*.[0-9]*.[0-9]*.[0-9]*/[0-9]*) ;;
        *) echo "not an IPv4 address: $ADDR"; exit 1 ;;
    esac
    GW=$(ip route show default | awk '{print $3; exit}')
    [ -n "$GW" ] || GW=$(echo "$ADDR" | sed 's#\([0-9]*\.[0-9]*\.[0-9]*\)\..*#\1.1#')
    sed -i "/^# w01-static/,/^# w01-static-end/d" /etc/dhcpcd.conf 2>/dev/null
    {
        echo "# w01-static"
        echo "interface $W"
        echo "static ip_address=$ADDR"
        echo "static routers=$GW"
        echo "static domain_name_servers=$GW 1.1.1.1"
        echo "# w01-static-end"
    } >> /etc/dhcpcd.conf
    systemctl restart "dhcpcd@$W"
    sleep 5
    echo "static address configured (survives reboot)"
    echo
    show_status
    ;;

dhcp)
    sed -i "/^# w01-static/,/^# w01-static-end/d" /etc/dhcpcd.conf 2>/dev/null
    systemctl restart "dhcpcd@$W"
    sleep 5
    show_status
    ;;

forget)
    rm -f "$CONF"
    systemctl disable "wpa_supplicant@$W" >/dev/null 2>&1
    systemctl stop "wpa_supplicant@$W"    >/dev/null 2>&1
    echo "saved network removed"
    ;;

*)
    sed -n '3,14p' "$0" | sed 's/^# \{0,1\}//'
    ;;
esac
