diff --git a/Makefile b/Makefile
index f3e90de..da3f5b5 100644
--- a/Makefile
+++ b/Makefile
@@ -3,6 +3,13 @@
 #CONFIG_ATBM601x: 1T1R 80211b/g/n, HT20
 #if yout want to change .conf, please do make menuconfig in current path
 ############################################################################
+# $(src) is only set when kbuild reads this file as a Kbuild fragment. On the
+# initial top-level invocation it is empty, so "-include $(src)/.config" reads
+# /.config, silently finds nothing, and every CONFIG_ATBM_* stays unset - which
+# means SDIO_BUS never becomes y and -DSDIO_BUS is never passed. Resolve the
+# path from this makefile's own location instead so it works either way.
+ATBM_SELF_DIR := $(dir $(lastword $(MAKEFILE_LIST)))
+-include $(ATBM_SELF_DIR).config
 -include $(src)/.config
 
 ############################################################################
